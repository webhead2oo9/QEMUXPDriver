#include <windows.h>

#if defined(QXPMAP_FIXTURE_OLDER)
#define FIXTURE_FILEVERSION 0,65535,65535,65535
#define FIXTURE_VERSION_TEXT "0.65535.65535.65535\0"
#elif defined(QXPMAP_FIXTURE_NEWER)
#define FIXTURE_FILEVERSION 1,0,0,1
#define FIXTURE_VERSION_TEXT "1.0.0.1\0"
#else
#define FIXTURE_FILEVERSION 1,0,0,0
#define FIXTURE_VERSION_TEXT "1.0.0.0\0"
#endif

1 VERSIONINFO
FILEVERSION FIXTURE_FILEVERSION
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DRV
FILESUBTYPE VFT2_DRV_SYSTEM
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "XPDriver project\0"
            VALUE "ProductName", "XPDriver test fixture\0"
            VALUE "FileDescription", "Fake-SCM qxpmap test image; never load\0"
            VALUE "InternalName", "qxpmap_fixture\0"
            VALUE "OriginalFilename", "qxpmap.sys\0"
            VALUE "FileVersion", FIXTURE_VERSION_TEXT
            VALUE "ProductVersion", "1.0.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

#include <winver.h>
#include "xpdriver_version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION XPD_VERSION_RC
 PRODUCTVERSION XPD_VERSION_RC
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DRV
 FILESUBTYPE VFT2_DRV_SYSTEM
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "XPDriver project\0"
            VALUE "FileDescription", "XPDriver guest memory-window driver\0"
            VALUE "FileVersion", XPD_VERSION_STR
            VALUE "InternalName", "qxpmap\0"
            VALUE "LegalCopyright", "GPL-2.0-only\0"
            VALUE "OriginalFilename", "qxpmap.sys\0"
            VALUE "ProductName", "XPDriver\0"
            VALUE "ProductVersion", XPD_VERSION_FULL
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
